{
  "name": "github-webhook-node-ci",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "sender": "node --env-file=.env src/sender.js",
    "start": "node --env-file=.env src/server.js",
    "secret": "node --env-file=.env src/utils/secret.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.{js,ts,jsx,tsx}\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "axios": "1.13.2",
    "body-parser": "2.2.0",
    "crypto": "1.0.1",
    "esm-module-alias": "^2.2.1",
    "express": "5.1.0",
    "joi": "18.0.1"    
  },
  "devDependencies": {
    "@swc/core": "^1.3.6",
    "@swc/jest": "^0.2.23",
    "@types/jest": "^30.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "^30.2.0",
    "sonar-scanner": "^3.1.0",
    "supertest": "^7.1.4",
    "prettier": "^3.6.2"
  },
  "imports": {
    "#validate/*": "./src/validate/*"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.(js|ts)$",
    "transform": {
      "^.+\\.(t|j)s$": "@swc/jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
